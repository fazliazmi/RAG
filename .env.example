# Copy this file to .env and fill in what you need. Everything here is optional.

# Free NVD API key: https://nvd.nist.gov/developers/request-an-api-key
# Raises the NVD rate limit from 5 to 50 requests per 30 seconds (full CVE download: ~40 min -> ~5 min).
NVD_API_KEY=

# Which LLM profile to use (a file in config/llm/, without .yaml).
# CYBERRAG__LLM_PROFILE=llama3.2-3b

# Override single settings without editing YAML (double underscore = nesting).
# CYBERRAG__LLM__MODEL=llama3.2:3b
# CYBERRAG__LLM__NUM_CTX=8192
# Which embedding profile to use (a file in config/embeddings/). Re-index after changing.
# CYBERRAG__EMBEDDING_PROFILE=arctic-embed-xs
# CYBERRAG__EMBEDDINGS__BASE_URL=http://127.0.0.1:11434
# CYBERRAG__VECTOR_STORE__URL=http://127.0.0.1:6333

# Only needed for openai_compat profiles that talk to a hosted API.
# OPENAI_API_KEY=
